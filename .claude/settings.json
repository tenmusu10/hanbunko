{
  "permissions": {
    "deny": [
      "Read(./package-lock.json)",
      "Read(./www/**)",
      "Read(./dist/**)",
      "Read(./node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__merge_pull_request|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"; [ ! -f \"$f\" ] || node \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
