{
  "name": "hanbunko",
  "version": "0.1.0",
  "private": true,
  "description": "はんぶんこ：半分だけ届けて、残りは2人で埋めるパートナー向け共有アプリ",
  "scripts": {
    "check": "node scripts/release-check.mjs",
    "test": "node --test scripts/release-check.test.mjs tools/secret-check.test.mjs tools/digest.test.mjs .claude/hooks/guard.test.mjs",
    "secret:check": "node tools/secret-check.mjs",
    "smoke": "node tools/smoke.js index.html",
    "rules:test": "firebase emulators:exec --project demo-hanbunko --only firestore \"node --test tests/rules.test.mjs\"",
    "pair:test": "firebase emulators:exec --project hanbunko-dba56 --only firestore,auth \"node tools/pair-test.js\"",
    "store": "node tools/make-store.mjs",
    "store:check": "node tools/store-check.mjs",
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync android",
    "release": "node scripts/build-www.mjs --release && npx cap sync android",
    "android": "npm run sync && npx cap open android",
    "play:test": "node --test tools/play/lib.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
